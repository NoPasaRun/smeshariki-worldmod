{
	"schemaVersion": 1,
	"id": "worldmod",
	"version": "${version}",
	"name": "WorldMod",
	"description": "Мир: ландшафт («Остров Смешариков», «Мир-океан»), шейдерпак Iris, свет неба и приглушение света кат-сцен, река с потоком брёвен (маршруты и поток).",
	"authors": ["bogdan"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.smeshariki.world.WorldMod"],
		"client": ["com.smeshariki.world.WorldModClient"]
	},
	"mixins": [{ "config": "worldmod.mixins.json", "environment": "client" }],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"gameplaymod": "*"
	},
	"breaks": {
		"smesharikiworld": "*"
	}
}
